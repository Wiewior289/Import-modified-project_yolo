+    const VkPhysicalDeviceMemoryProperties& memory_properties = vkdev->info.physicalDeviceMemoryProperties();
+    const uint32_t blob_memory_type_index = opt_staging.blob_vkallocator
+        ? opt_staging.blob_vkallocator->buffer_memory_type_index : static_cast<uint32_t>(-1);
+    const bool blob_memory_type_valid = blob_memory_type_index < memory_properties.memoryTypeCount;
+    const VkFlags blob_memory_flags = blob_memory_type_valid
+        ? memory_properties.memoryTypes[blob_memory_type_index].propertyFlags : 0;
+    const bool blob_buffer_mappable = (blob_memory_flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) != 0;
+    const bool blob_buffer_cached = (blob_memory_flags & VK_MEMORY_PROPERTY_HOST_CACHED_BIT) != 0;
+    if (!blob_buffer_mappable || !blob_buffer_cached)
     {
         opt_staging.blob_vkallocator = opt.staging_vkallocator;
     }
     int cast_type_to = 0;
