+int VkCompute::submit()
+{
+    if (d->submitted || d->needs_reset || d->async_submit)
+        return -1;
+    d->async_submit = true;
+    const int ret = submit_and_wait();
+    d->async_submit = false;
+    return ret;
+}
+
+int VkCompute::wait()
+{
+    if (!d->submitted)
+    {
+        NCNN_LOGE("[NCNN_VK_ASYNC_WAIT] called without a pending submission");
+        return -1;
+    }
+    using async_clock = std::chrono::steady_clock;
+    const auto wait_start = async_clock::now();
+    const auto fence_start = async_clock::now();
+    VkResult ret = vkWaitForFences(vkdev->vkdevice(), 1, &d->compute_command_fence,
+                                   VK_TRUE, (uint64_t)-1);
+    const double fence_wait_wall_ms = std::chrono::duration<double, std::milli>(
+        async_clock::now() - fence_start).count();
+    if (ret != VK_SUCCESS)
+    {
+        NCNN_LOGE("[NCNN_VK_ASYNC_WAIT] vkWaitForFences failed %d", ret);
+        return -1;
+    }
+    const auto post_start = async_clock::now();
+    for (size_t i = 0; i < d->delayed_records.size(); i++)
+    {
+        const VkComputePrivate::record& r = d->delayed_records[i];
+        switch (r.type)
+        {
+        case VkComputePrivate::record::TYPE_post_download:
+        {
+            const VkMat& src = d->download_post_buffers[r.post_download.download_post_buffer_mat_offset];
+            Mat& dst = d->download_post_mats_fp16[r.post_download.download_post_mat_fp16_offset];
+            src.allocator->invalidate(src.data);
+            for (int b = 0; b < dst.n; b++)
+            {
+                const VkMat src_b = src.batch(b);
+                Mat dst_b = dst.batch(b);
+                memcpy(dst_b.data, src_b.mapped_ptr(), dst_b.total() * dst_b.elemsize);
+            }
+            break;
+        }
+        case VkComputePrivate::record::TYPE_post_cast_float16_to_float32:
+        {
+            const Mat& src = d->download_post_mats_fp16[r.post_cast_float16_to_float32.download_post_mat_fp16_offset];
+            Mat& dst = d->download_post_mats[r.post_cast_float16_to_float32.download_post_mat_offset];
+            Option opt;
+            opt.num_threads = r.post_cast_float16_to_float32.num_threads;
+            opt.blob_allocator = dst.allocator;
+            ncnn::cast_float16_to_float32(src, dst, opt);
+            break;
+        }
+        case VkComputePrivate::record::TYPE_post_cast_bfloat16_to_float32:
+        {
+            const Mat& src = d->download_post_mats_fp16[r.post_cast_bfloat16_to_float32.download_post_mat_bf16_offset];
+            Mat& dst = d->download_post_mats[r.post_cast_bfloat16_to_float32.download_post_mat_offset];
+            Option opt;
+            opt.num_threads = r.post_cast_bfloat16_to_float32.num_threads;
+            opt.blob_allocator = dst.allocator;
+            ncnn::cast_bfloat16_to_float32(src, dst, opt);
+            break;
+        }
+        default:
+            break;
+        }
+    }
+    const double post_download_cpu_ms = std::chrono::duration<double, std::milli>(
+        async_clock::now() - post_start).count();
+    d->delayed_records.clear();
+    d->pending_dispatch_total = 0;
+    d->submitted = false;
+    const double total_wall_ms = std::chrono::duration<double, std::milli>(
+        async_clock::now() - wait_start).count();
+    NCNN_LOGE("[NCNN_VK_ASYNC_WAIT] result=OK fence_wait_wall_ms=%.3f post_download_cpu_ms=%.3f total_wall_ms=%.3f",
+              fence_wait_wall_ms, post_download_cpu_ms, total_wall_ms);
+    return 0;
+}
+
 int VkCompute::reset()
 {
+    if (d->submitted)
+    {
+        NCNN_LOGE("[NCNN_VK_ASYNC] reset rejected while GPU work is pending");
+        return -1;
+    }
@@ -2112,4 +2234,5 @@ int VkCompute::reset()
 #endif // NCNN_BENCHMARK
